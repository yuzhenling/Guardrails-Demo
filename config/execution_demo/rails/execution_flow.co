define user request profile allowed
  "查询用户 U1001 的状态"

define flow
  user request profile allowed
  $ok = execute allow_user_lookup
  if $ok
    $user_info = execute fetch_user_data(user_id="U1001")
    bot say profile result
    stop

define bot say profile result
  "执行成功：已查询到用户 U1001，状态 active。"

define user request action
  "帮我删除"
  "帮我执行"
  "帮我清理"

define flow
  user request action
  $ok = execute check_action_terms
  if $ok
    $done = execute do_action()
    if $done
        bot request action result deny
        stop
    else
        bot request action result allow
        stop

define bot request action result allow
  "执行完毕"

define bot request action result deny
  "权限控制，禁止执行。"